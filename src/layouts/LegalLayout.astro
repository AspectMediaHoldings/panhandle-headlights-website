---
import BaseLayout from './BaseLayout.astro';
const { frontmatter } = Astro.props;
const title = frontmatter?.title || 'Legal';
const description = frontmatter?.description || 'Legal document — Panhandle Headlight Restoration.';
const lastRevised = frontmatter?.lastRevised || '';
const effective = frontmatter?.effective || '';
---
<BaseLayout title={title + ' | Panhandle Headlight Restoration'} description={description}>
  <section class="wrap legal-doc">
    <article class="legal-body">
      {(effective || lastRevised) && (
        <p class="legal-dates">
          {effective && <span><strong>Effective:</strong> {effective}</span>}
          {effective && lastRevised && <span aria-hidden="true"> &middot; </span>}
          {lastRevised && <span><strong>Last Revised:</strong> {lastRevised}</span>}
        </p>
      )}
      <slot />
      <hr class="legal-sep" />
      <p class="legal-nav-note">
        <a href="/legal/">Back to legal documents</a> &middot; <a href="/">Home</a> &middot; Questions? <a href="tel:+18505836322">(850) 583-6322</a>
      </p>
    </article>
  </section>
</BaseLayout>

<style is:global>
  .legal-doc { max-width: 820px; margin-inline: auto; padding-block: 3rem; }
  .legal-body { line-height: 1.65; color: var(--text, #222); font-size: 1.02rem; }
  .legal-body h1 { font-size: clamp(1.6rem, 1.2rem + 1.8vw, 2.4rem); margin: 0 0 .6rem; line-height: 1.15; }
  .legal-body h2 { font-size: 1.25rem; margin: 2.2rem 0 .8rem; padding-top: .6rem; border-top: 1px solid var(--line, #e5e2dc); }
  .legal-body h3 { font-size: 1.08rem; margin: 1.6rem 0 .5rem; font-weight: 700; }
  .legal-body h4 { font-size: 1rem; margin: 1.2rem 0 .4rem; font-weight: 700; }
  .legal-body p { margin: 0 0 1rem; }
  .legal-body ul, .legal-body ol { margin: 0 0 1.2rem; padding-left: 1.4rem; }
  .legal-body li { margin-bottom: .35rem; }
  .legal-body table { width: 100%; border-collapse: collapse; margin: 1rem 0 1.4rem; font-size: .95rem; }
  .legal-body th, .legal-body td { border: 1px solid var(--line, #e5e2dc); padding: .55rem .7rem; text-align: left; vertical-align: top; }
  .legal-body th { background: var(--paper-2, #f5f1eb); font-weight: 700; }
  .legal-body hr { border: 0; border-top: 1px solid var(--line, #e5e2dc); margin: 2.4rem 0; }
  .legal-body strong { font-weight: 700; color: var(--text, #222); }
  .legal-body a { color: var(--ink, #14181f); text-decoration: underline; text-underline-offset: 2px; }
  .legal-body a:hover { text-decoration-thickness: 2px; }
  .legal-dates { color: var(--muted, #666); font-size: .95rem; margin: 0 0 1.8rem; }
  .legal-sep { margin-top: 3rem; }
  .legal-nav-note { color: var(--muted, #666); font-size: .92rem; text-align: center; }
</style>
